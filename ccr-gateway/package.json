{
  "name": "ccr-gateway",
  "version": "0.1.0",
  "description": "Private Claude Code Gateway and Compliance Layer",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:edge": "tsx watch src/edge.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:edge": "node dist/edge.js",
    "start:resilient": "npm run build && node --max-old-space-size=512 dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1075.0",
    "@aws-sdk/credential-providers": "^3.1075.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.22.0",
    "undici": "^6.19.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.0",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
