# ccr-core (src/server.ts) — internal-only, reached only by ccr-edge
PORT=8081
UPSTREAM_URL=https://api.anthropic.com
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MANTLE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
AWS_REGION=us-east-1

# Postgres (src/schema.sql) — docker-compose reads POSTGRES_PASSWORD from .env automatically
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://ccr_admin:<password>@localhost:5432/ccr_db

# ccr-edge (src/edge.ts) — client-facing front door
# Set these when launching edge.ts directly; the PM2 ecosystem config sets
# them per-app automatically, so this only matters for manual/foreground runs.
# PORT=8080
# CORE_URL=http://127.0.0.1:8081

# Optional — gates /admin/* with an x-admin-token header when set. Unset = no auth.
ADMIN_TOKEN=
